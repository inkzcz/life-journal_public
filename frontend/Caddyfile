{
    log default {
        format filter {
            wrap json
            fields {
                request>uri delete
                request>headers>Authorization delete
                request>headers>Cookie delete
                request>headers>X-Csrf-Token delete
                request>headers>X-CSRF-Token delete
                request>headers>X-Setup-Key delete
            }
        }
    }
}

:80 {
    encode zstd gzip
    # Only the authenticated ZIP inspection endpoint accepts a larger package.
    # Existing individual image uploads retain their 11MB proxy / 10MB API caps.
    handle /api/admin/exchange/preview {
        request_body {
            max_size 51MB
        }
        reverse_proxy api:8000
    }
    handle /api/admin/exchange/inspect {
        request_body {
            max_size 51MB
        }
        reverse_proxy api:8000
    }
    handle /api/* {
        request_body {
            max_size 11MB
        }
        reverse_proxy api:8000
    }
    handle /assets/* {
        root * /srv
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob:; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
        ?Cache-Control "no-store"
    }
}
