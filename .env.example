# Copy privately to .env in your deployment folder. Never commit real values.
POSTGRES_DB=life_journal
POSTGRES_USER=life_journal
POSTGRES_PASSWORD=
# Generate your own random authorization key, at least32 characters.
# Required only for first setup; clear it after completing setup.
SETUP_KEY=
# Keep true for HTTPS deployments. HTTP loopback tests only: false.
COOKIE_SECURE=true
# Default: host loopback only. For trusted LAN, set the trusted private LAN IP.
WEB_BIND_IP=127.0.0.1
WEB_PORT=18080
# REQUIRED: exact reviewed business image tag (candidate tags include the public commit).
# Match the local bundle or a future formal Release; do not use latest.
IMAGE_TAG=
# Maintenance alone coordinates guarded migrations; API waits for readiness.
# Default true: only audited compatible migrations after actual backup restore.
AUTO_MIGRATE_ON_STARTUP=true
# Change ONLY after investigating a failed/interrupted upgrade. Not a secret.
# A new value retries ALL checks; it never skips backup/restore validation.
AUTO_MIGRATION_RETRY_TOKEN=

# API waits for the independent Maintenance gate before serving HTTP.
# Import the matching Compose; do not reverse the dependency to Maintenance -> API.
MIGRATION_WAIT_SECONDS=1800

# REQUIRED: exact existing PostgreSQL 17 image reference (prefer an immutable digest).
# Prepare independently BEFORE Compose startup. No automatic pull or database TAR is supplied.
POSTGRES_IMAGE=

# New installations only: keep these private and preserve existing mappings when upgrading.
DB_DATA_DIR=./postgres
MEDIA_DATA_DIR=./media
BACKUP_DATA_DIR=./backup
