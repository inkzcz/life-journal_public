        "key": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Key",
          "type": "string"
        },
        "day": {
          "format": "date",
          "title": "Day",
          "type": "string"
        },
        "time": {
          "anyOf": [
            {
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time"
        },
        "kind": {
          "default": "other",
          "enum": [
            "food",
            "sight",
            "transport",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 10000,
          "title": "Description",
          "type": "string"
        },
        "place_key": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Place Key"
        },
        "media_keys": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Media Keys",
          "type": "array"
        }
      },
      "required": [
        "key",
        "day",
        "title"
      ],
      "title": "Activity",
      "type": "object"
    },
